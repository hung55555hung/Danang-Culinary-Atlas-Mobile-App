# ⚠️ QUAN TRỌNG: Copy file này thành .env và điền token của bạn
# File .env sẽ KHÔNG được commit lên Git (đã có trong .gitignore)

# Mapbox Access Token (Public Token - bắt đầu với pk.)
# Get from: https://console.mapbox.com/account/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# Hướng dẫn:
# 1. Tạo file .env: cp .env.example .env
# 2. Đăng nhập Mapbox: https://console.mapbox.com/
# 3. Copy Public Token (pk.) từ: https://console.mapbox.com/account/access-tokens/
# 4. Paste vào file .env
# 5. KHÔNG commit file .env lên Git!
